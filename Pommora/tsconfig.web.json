{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@pommora/core/*": ["../Core/*"],
      "@pommora/uix/*": ["../UIX/*"]
    },
    "noEmit": true
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "../Core/Platform/dialer.ts"]
}
