{
  "autoMemoryDirectory": "~/.claude/memory/pommora",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-wrapped-comments.mjs\"",
            "statusMessage": "Checking comment style"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/The Studio/.claude/hooks/no-name-mentions.mjs\"",
            "statusMessage": "Checking for name mentions"
          }
        ]
      }
    ]
  }
}
