"![[P\\|a]]" index 1 whole false
== linksIn before || after(loop kept) || after(loop removed)
"![[P]]" ["embed:p#@0"] || ["wiki:p#@1","embed:p#@0"] || ["wiki:p#@1"]
"![[P#H|a]]" ["embed:p#h|a@0"] || ["wiki:p#h@1","embed:p#h|a@0"] || ["wiki:p#h@1"]
"!![[P]]" ["embed:p#@1"] || ["wiki:p#@2","embed:p#@1"] || ["wiki:p#@2"]
"![[P]]]" ["embed:p#@0"] || ["wiki:p#@1","embed:p#@0"] || ["wiki:p#@1"]
"![[]]" ["embed:own#@0"] || ["embed:own#@0"] || []
"x ![[P]] y" ["embed:p#@2"] || ["wiki:p#@3","embed:p#@2"] || ["wiki:p#@3"]
"![[#H]]" ["embed:own#h@0"] || ["wiki:own#h@1","embed:own#h@0"] || ["wiki:own#h@1"]
"![[P|a]]" ["embed:p|a#@0"] || ["wiki:p#@1","embed:p|a#@0"] || ["wiki:p#@1"]
"![[P\\|a]]" ["embed:p\\|a#@0"] || ["wiki:p#@1","embed:p\\|a#@0"] || ["wiki:p#@1"]
"![[Own]]" ["embed:own#@0"] || ["wiki:own#@1","embed:own#@0"] || ["wiki:own#@1"]
== sectionRunsIn §H inside embed: before || after
"![[A §Intro]] and §Intro" [{"from":5,"to":11,"heading":"Intro"},{"from":18,"to":24,"heading":"Intro"}] || [{"from":18,"to":24,"heading":"Intro"}]
== rewriteConnections Old->New: before || after(passes kept) || after(passes removed)
"![[Old]]" "![[New]]" || "![[New]]" || "![[New]]"
"![[Old#H]]" "![[New#H]]" || "![[New#H]]" || "![[New#H]]"
"![[Old|a]]" "![[Old|a]]" || "![[New|a]]" || "![[New|a]]"
"!![[Old]]" "!![[New]]" || "!![[New]]" || "!![[New]]"
"x ![[Old]] [[Old]] [y](Old)" "x ![[New]] [[New]] [y](New)" || "x ![[New]] [[New]] [y](New)" || "x ![[New]] [[New]] [y](New)"
"`![[Old]]`" "`![[Old]]`" || "`![[Old]]`" || "`![[Old]]`"
"![[Old\\|a]]" "![[Old\\|a]]" || "![[New\\|a]]" || "![[New\\|a]]"
== rewriteHeadingConnections P#H->Z
"![[P#H]]" "![[P#Z]]" || "![[P#Z]]" || "![[P#Z]]"
"![[P#H|a]]" "![[P#H|a]]" || "![[P#Z|a]]" || "![[P#Z|a]]"
"x ![[P#H]] [[P#H]]" "x ![[P#Z]] [[P#Z]]" || "x ![[P#Z]] [[P#Z]]" || "x ![[P#Z]] [[P#Z]]"
== E-09 anchored lone grammar
"![[P]]" old "P" new {"page":"P"} indices.page=[3,4] linkSpans {"full":[0,6],"title":[3,4],"heading":null,"alias":null}
"![[P]]  " old "P" new {"page":"P"} indices.page=[3,4] linkSpans {"full":[0,8],"title":[3,4],"heading":null,"alias":null}
"![[P#H]]" old "P#H" new {"page":"P","heading":"H"} indices.page=[3,4] linkSpans {"full":[0,8],"title":[3,4],"heading":[5,6],"alias":null}
"![[P|a]]" old "P|a" new {"page":"P","alias":"a"} indices.page=[3,4] linkSpans {"full":[0,8],"title":[3,4],"heading":null,"alias":[5,6]}
"![[]]" old "" new {"page":""} indices.page=[3,3] linkSpans null
"![[#H]]" old "#H" new {"page":"","heading":"H"} indices.page=[3,3] linkSpans {"full":[0,7],"title":[3,3],"heading":[4,5],"alias":null}
"  ![[P]]" old null new null linkSpans -
"![[P]]]" old null new null linkSpans -
"!![[P]]" old null new null linkSpans -
"![[P\\|a]]" old "P\\|a" new {"page":"P\\","alias":"a"} indices.page=[3,5] linkSpans {"full":[0,9],"title":[3,4],"heading":null,"alias":[6,7]}
"![[a]b]]" old null new {"page":"a]b"} indices.page=[3,6] linkSpans {"full":[0,8],"title":[3,6],"heading":null,"alias":null}
