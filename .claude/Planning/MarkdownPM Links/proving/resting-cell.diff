+import { describe, expect, it } from 'vitest'
+import { seatSelection } from './CellEditor'
+
+const at = (pos: number | null) => () => pos
+
+describe('where an entered cell seats its selection', () => {
+  it('takes the caret at the end when entered with no seat', () => {
+    expect(seatSelection(null, 9, at(3))).toEqual({ anchor: 9, head: 9 })
+  })
+
+  it('takes the caret under the pointer, or the end where the pointer reads nothing', () => {
+    expect(seatSelection({ kind: 'point', x: 1, y: 2 }, 9, at(3))).toEqual({ anchor: 3, head: 3 })
+    expect(seatSelection({ kind: 'point', x: 1, y: 2 }, 9, at(null))).toEqual({
+      anchor: 9,
+      head: 9,
+    })
+  })
+
+  it('extends a crossing sweep from the edge it came in by', () => {
+    expect(seatSelection({ kind: 'point', x: 1, y: 2, sweep: 'start' }, 9, at(3))).toEqual({
+      anchor: 0,
+      head: 3,
+    })
+    expect(seatSelection({ kind: 'point', x: 1, y: 2, sweep: 'end' }, 9, at(3))).toEqual({
+      anchor: 9,
+      head: 3,
+    })
+  })
+
+  it('selects a range, clamped to the text', () => {
+    expect(seatSelection({ kind: 'select', range: [2, 5] }, 9, at(3))).toEqual({
+      anchor: 2,
+      head: 5,
+    })
+    expect(seatSelection({ kind: 'select', range: [7, 12] }, 9, at(3))).toEqual({
+      anchor: 7,
+      head: 9,
+    })
+  })
+})
