new file mode 100644
index 000000000..87781b7f6
--- /dev/null
+++ b/Core/Views/Settings/ViewPane.tsx
@@ -0,0 +1,109 @@
+import type { CollectionNode, SetNode } from '../../Nexus/tree'
+import type { PropertyDefinition } from '../../Properties/properties'
+import type { SavedView, ViewWriter } from '../views'
+import { useSession } from '../../Session/store'
+import { readLiveView, useSaveView } from '../Host/liveView'
+import { Icon, type IconName } from '@pommora/uix/Symbols'
+import type { MenuRow } from '@pommora/uix/Menus/MenuIndex'
+import { type MenuBack, MenuSeparator } from '@pommora/uix/Menus/MenuRows'
+import { ICON } from '@pommora/uix/Menus/frames.css'
+import { VisibilityFrame } from './VisibilityFrame'
+import { kindSwitches, LayoutFrame } from './LayoutFrame'
+import { GroupFrame } from './GroupFrame'
+import { SortFrame } from './SortFrame'
+import { FilterFrame } from './FilterFrame'
+
+export type ViewPaneId = 'visibility' | 'layout' | 'group' | 'filter' | 'sort'
+
+export interface SettingsPane<Id extends string = ViewPaneId> {
+  id: Id
+  label: string
+  icon: IconName
+}
+
+export const VIEW_PANES: SettingsPane[] = [
+  { id: 'visibility', label: 'Visibility', icon: 'eye' },
+  { id: 'layout', label: 'Layout', icon: 'layout-dashboard' },
+  { id: 'group', label: 'Group', icon: 'layers' },
+  { id: 'filter', label: 'Filter', icon: 'list-filter' },
+  { id: 'sort', label: 'Sort', icon: 'arrow-up-down' },
+]
+
+export const chevronRows = <Id extends string>(
+  panes: SettingsPane<Id>[],
+  open: (id: Id) => void,
+  frozen?: (id: Id) => boolean,
+): MenuRow[] =>
+  panes.map((p) => ({
+    kind: 'item',
+    icon: <Icon name={p.icon} size={ICON.rootEntry} />,
+    label: p.label,
+    trailing: { kind: 'chevron' },
+    disabled: frozen?.(p.id),
+    onSelect: () => open(p.id),
+  }))
+
+export interface PaneProps {
+  view: SavedView
+  schema: PropertyDefinition[]
+  back: MenuBack
+  save: ViewWriter
+}
+
+export function ViewPane({
+  id,
+  source,
+  view,
+  schema,
+  back,
+  current,
+  switches = false,
+}: {
+  id: ViewPaneId
+  source: CollectionNode | SetNode
+  view: SavedView
+  schema: PropertyDefinition[]
+  back: MenuBack
+  current?: string
+  switches?: boolean
+}): React.JSX.Element {
+  const tree = useSession((st) => st.tree)
+  const saveView = useSaveView(source)
+  const pane: PaneProps = { view, schema, back, save: (patch) => saveView(view, patch) }
+  switch (id) {
+    case 'visibility':
+      return (
+        <VisibilityFrame
+          {...pane}
+          current={current}
+          footer={
+            switches ? (
+              <>
+                <MenuSeparator flush />
+                {kindSwitches(view, pane.save)}
+              </>
+            ) : undefined
+          }
+        />
+      )
+    case 'layout':
+      return <LayoutFrame {...pane} />
+    case 'group':
+      return <GroupFrame {...pane} source={source} />
+    case 'sort':
+      return <SortFrame {...pane} />
+    case 'filter':
+      return (
+        <FilterFrame
+          key={view.id}
+          locations={source.sets ?? []}
+          view={view}
+          read={() => readLiveView(source.id, view)}
+          schema={schema}
+          tree={tree}
+          back={back}
+          onCommit={pane.save}
+        />
+      )
+  }
+}
