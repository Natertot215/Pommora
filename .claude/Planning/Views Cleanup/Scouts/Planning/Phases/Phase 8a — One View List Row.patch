-        : [{ label: shownLabel(ctx.titlesShown, 'Titles'), action: 'titles' as const }]),
+        : [{ label: shownLabel(titlesShown, 'Titles'), action: 'titles' as const }]),
     ],
     itemRows(ctx),
   ])
