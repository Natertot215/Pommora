+
+export function hiddenListIds(
+  view: SavedView,
+  schema: PropertyDefinition[],
+  contextIds: readonly string[],
+): string[] {
+  const shown = shownIn(view)
+  const hidden = (id: string): boolean => !shown(id)
+  return [
