diff --git a/Desktop/Platform/nodeMachine.ts b/Desktop/Platform/nodeMachine.ts
index 5c1167917..32125638e 100644
--- a/Desktop/Platform/nodeMachine.ts
+++ b/Desktop/Platform/nodeMachine.ts
@@ -97,6 +97,13 @@ async function stage({
   }
 }
 
+const benchIo = ((globalThis as any).__benchIo ??= { calls: {}, trash: {} }) as { calls: Record<string, number>; trash: Record<string, number> }
+const counted = <F extends (p: string, ...a: any[]) => any>(name: string, f: F): F =>
+  ((p: string, ...a: any[]) => {
+    benchIo.calls[name] = (benchIo.calls[name] ?? 0) + 1
+    if (typeof p === 'string' && p.includes('/.trash/')) benchIo.trash[name] = (benchIo.trash[name] ?? 0) + 1
+    return f(p, ...a)
+  }) as F
 export const nodeMachine: Machine = {
   readText: (p) => absentToNull(readFile(p, 'utf8')),
   readBytes: (p) => absentToNull(readFile(p)),
@@ -129,3 +136,12 @@ export const nodeMachine: Machine = {
   platform: isWindows ? 'windows' : 'posix',
   home: posixPath(realpathSync.native(homedir())),
 }
+for (const k of ['readText', 'readBytes', 'stat', 'readDir', 'mkdir', 'rename', 'remove'] as const)
+  (nodeMachine as any)[k] = counted(k, (nodeMachine as any)[k])
+const landAll = nodeMachine.land
+nodeMachine.land = (files) => {
+  benchIo.calls.land = (benchIo.calls.land ?? 0) + files.length
+  const trashed = files.filter((f) => f.path.includes('/.trash/')).length
+  if (trashed) benchIo.trash.land = (benchIo.trash.land ?? 0) + trashed
+  return landAll(files)
+}
