.DS_Store
*.log
.env
.env.*
*.local

# Editors
.vscode/
.idea/

# React / Node
node_modules/
dist/

# Pommora — per-nexus app-internal config
# Skipped from any git-tracked folder used as a dev test nexus
# (e.g. when pointing Pommora at the Studio or a project subfolder)
.nexus/

# Graphify — regeneratable knowledge-graph output (55MB+, rebuilt via `graphify update .`)
graphify-out/

# Playwright MCP — tool console logs / page traces (regeneratable)
.playwright-mcp/

# Claude Code — settings.json travels: it carries the ~-relative auto-memory
# route, which resolves on every machine. Genuinely machine-bound overrides
# (absolute paths, per-host hooks) belong in the .local overlay instead.
.claude/settings.local.json
