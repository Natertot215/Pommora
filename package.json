{
  "name": "pommora",
  "private": true,
  "workspaces": [
    "UIX",
    "Core",
    "Desktop",
    "Mobile",
    "Sync",
    "Dashboard"
  ],
  "scripts": {
    "dev": "npm run dev -w Desktop",
    "build": "npm run build -w Desktop",
    "package": "npm run package -w Desktop",
    "icon": "node --no-warnings Desktop/scripts/makeIcon.mjs",
    "dashboard": "npm run dev -w Dashboard",
    "build:dashboard": "npm run build -w Dashboard",
    "sync": "node Sync/hub.ts",
    "sync:cert": "sh Sync/scripts/cert.sh",
    "sync:image": "docker build -f Sync/Dockerfile -t pommora-hub .",
    "typecheck": "tsc -p UIX && tsc -p Core && tsc -p Core/tsconfig.src.json && tsc -p Desktop/tsconfig.node.json && tsc -p Desktop/tsconfig.web.json && tsc -p Sync && tsc -p Dashboard",
    "test": "vitest run",
    "lint": "biome check . && node .claude/hooks/no-wrapped-comments.mjs --scan",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^25.9.3",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
